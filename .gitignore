node_modules/
dist/
*.log
.env
.env.local
.DS_Store

# Playwright MCP browser-automation artifacts (page snapshots, console logs)
.playwright-mcp/

# Single-binary build pipeline (oam compile): build-binary-oam.mjs + stage-release-asset.mjs
bin/*
!bin/aws-mcp.mjs
build-tmp/
dist-release/

# Older oam releases were documented as writing a bytecode cache here; 0.21.1
# keeps its caches under ~/.oam instead (measured 2026-11-22). Kept as cheap insurance.
oam/

# npm auth token -- never commit (a project-local .npmrc can be
# created by tooling and would carry a live automation token)
.npmrc
