node_modules/
dist/
*.log
.env
.env.local
.DS_Store

# Playwright MCP browser-automation artifacts (page snapshots, console logs)
.playwright-mcp/

# Single-binary build pipeline (Node SEA): build-binary.mjs + stage-release-asset.mjs
bin/*
!bin/aws-mcp.mjs
build-tmp/
dist-release/

# oam.js writes a bytecode cache here on any `oam run` / `oam check`
oam/

# npm auth token -- never commit (a project-local .npmrc can be
# created by tooling and would carry a live automation token)
.npmrc
